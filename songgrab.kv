#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# 全局默认色：所有控件默认跟着主题走（具体规则里显式写的会覆盖它）
<Screen>:
    canvas.before:
        Color:
            rgba: app.theme.bg
        Rectangle:
            pos: self.pos
            size: self.size

<Label>:
    color: app.theme.text

<Button>:
    color: app.theme.btn_text

<TextInput>:
    background_normal: ''
    background_active: ''
    background_color: app.theme.input_bg
    foreground_color: app.theme.input_fg
    cursor_color: app.theme.accent
    hint_text_color: app.theme.text_hint

<SplashScreen>:
    canvas.before:
        Color:
            rgba: app.theme.bg
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(40), dp(80), dp(40), dp(80)
        Image:
            source: 'assets/icon.png'
            size_hint_y: None
            height: self.width
            mipmap: True
        Widget:
            size_hint_y: 0.12
        Label:
            text: '肥鱼音乐'
            font_name: app.font_name
            font_size: sp(30)
            color: app.theme.text
            size_hint_y: None
            height: dp(48)
        Label:
            text: 'SongGrab'
            font_name: app.font_name
            font_size: sp(14)
            color: app.theme.text_hint
            size_hint_y: None
            height: dp(26)
        Label:
            id: splash_tip
            text: '正在加载…'
            font_name: app.font_name
            font_size: sp(12)
            color: app.theme.text_hint
            size_hint_y: None
            height: dp(24)
        Widget:
            size_hint_y: 0.18


<ResultRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    padding: dp(10), dp(6)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: app.theme.surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7)]
    Label:
        text: root.song
        font_name: app.font_name
        font_size: sp(15)
        padding: dp(2), 0
        halign: 'left'
        valign: 'middle'
        size_hint_x: 0.42
        text_size: self.width - dp(6), None
        shorten: True
        shorten_from: 'right'
    Label:
        text: root.status
        font_name: app.font_name
        font_size: sp(13)
        color: root.color_for(root.style)
        size_hint_x: 0.16
        halign: 'center'
        text_size: self.width, None
    Label:
        text: root.reason
        font_name: app.font_name
        font_size: sp(12)
        color: app.theme.text_dim
        size_hint_x: 0.42
        halign: 'left'
        valign: 'middle'
        text_size: self.width - dp(6), None
        shorten: True
        shorten_from: 'right'


<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(7)

        # ---------- 顶栏 ----------
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Label:
                text: '肥鱼音乐'
                font_name: app.font_name
                font_size: sp(21)
                bold: True
                halign: 'left'
                text_size: self.width, None
            Button:
                text: '设置'
                font_name: app.font_name
                font_size: sp(14)
                size_hint_x: None
                width: dp(64)
                background_normal: ''
                background_color: app.theme.btn
                on_release: app.sm.current = 'settings'

        # ---------- 歌单输入 ----------
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(150)
            spacing: dp(5)
            TextInput:
                id: song_input
                font_name: app.font_name
                font_size: sp(14)
                multiline: True
                hint_text: '一行一首。歌名+歌手用加号分隔…'
                background_color: app.theme.input_bg
                foreground_color: app.theme.input_fg
                cursor_color: app.theme.accent
            BoxLayout:
                size_hint_y: None
                height: dp(42)
                spacing: dp(6)
                Button:
                    text: '导入 txt'
                    font_name: app.font_name
                    font_size: sp(13)
                    background_normal: ''
                    background_color: app.theme.btn
                    on_release: app.pick_playlist()
                Button:
                    text: '清空'
                    font_name: app.font_name
                    font_size: sp(13)
                    background_normal: ''
                    background_color: app.theme.btn
                    on_release: root.ids.song_input.text = ''
                Button:
                    text: '试搜'
                    font_name: app.font_name
                    font_size: sp(13)
                    background_normal: ''
                    background_color: app.theme.accent
                    on_release: app.try_search()

        Label:
            text: '提示：歌名+歌手，用加号，如 晴天+周杰伦；不加加号则整串当歌名'
            font_name: app.font_name
            font_size: sp(11)
            color: app.theme.text_sub
            size_hint_y: None
            height: dp(34)
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None

        # ---------- 输出去向 ----------
        BoxLayout:
            size_hint_y: None
            height: dp(34)
            spacing: dp(6)
            Label:
                text: '输出：' + app.out_dir
                font_name: app.font_name
                font_size: sp(11)
                color: app.theme.text_sub
                halign: 'left'
                text_size: self.width, None
                shorten: True
                shorten_from: 'left'
            Button:
                text: '打开'
                font_name: app.font_name
                font_size: sp(11)
                size_hint_x: None
                width: dp(52)
                background_normal: ''
                background_color: app.theme.btn
                on_release: app.do_open_folder()

        # ---------- 主操作 ----------
        ProgressBar:
            id: pbar
            size_hint_y: None
            height: dp(8)
            max: 1.0
            value: app.progress
            background_color: app.theme.neutral2
            border: (0, 0, 0, 0)

        Label:
            id: status_label
            text: app.status_text
            font_name: app.font_name
            font_size: sp(12)
            color: app.theme.text_dim
            size_hint_y: None
            height: dp(38)
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(8)
            Button:
                id: btn_start
                text: '开始下载'
                font_name: app.font_name
                font_size: sp(16)
                background_normal: ''
                background_color: app.theme.ok if not app.running else app.theme.disabled
                disabled: app.running
                on_release: app.start_download(root.ids.song_input.text)
            Button:
                text: '暂停'
                font_name: app.font_name
                font_size: sp(15)
                size_hint_x: None
                width: dp(84)
                background_normal: ''
                background_color: app.theme.danger if app.running else app.theme.disabled
                disabled: not app.running
                on_release: app.stop_download()

        # ---------- 结果区 ----------
        ScrollView:
            size_hint_y: 1
            do_scroll_x: False
            BoxLayout:
                id: row_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(5)

        # ---------- 底栏（两行，避免 5 个按钮挤在一起把字压扁） ----------
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)
            Button:
                text: '打开目录'
                font_name: app.font_name
                font_size: sp(13)
                background_normal: ''
                background_color: app.theme.btn
                on_release: app.do_open_folder()
            Button:
                text: '重试失败'
                font_name: app.font_name
                font_size: sp(13)
                background_normal: ''
                background_color: app.theme.btn
                on_release: app.retry_failed()
            Button:
                text: '复制失败'
                font_name: app.font_name
                font_size: sp(13)
                background_normal: ''
                background_color: app.theme.btn
                on_release: app.copy_failed()

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)
            Button:
                text: ('未确认：跳过' if app.require_confirm else '未确认：也下')
                font_name: app.font_name
                font_size: sp(13)
                background_normal: ''
                background_color: app.theme.ok_soft if app.require_confirm else app.theme.warn_soft
                on_release: app.toggle_require_confirm()
            Button:
                text: '清空'
                font_name: app.font_name
                font_size: sp(13)
                size_hint_x: 0.45
                background_normal: ''
                background_color: app.theme.btn
                on_release: root.clear_rows()


<SettingsScreen>:
    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            padding: dp(12)
            spacing: dp(8)
            size_hint_y: None
            height: self.minimum_height

            BoxLayout:
                size_hint_y: None
                height: dp(48)
                Button:
                    text: '返回'
                    font_name: app.font_name
                    font_size: sp(14)
                    size_hint_x: None
                    width: dp(64)
                    background_normal: ''
                    background_color: app.theme.btn
                    on_release: app.sm.current = 'main'
                Label:
                    text: '设置'
                    font_name: app.font_name
                    font_size: sp(19)
                    bold: True

            BoxLayout:
                size_hint_y: None
                height: dp(44)
                spacing: dp(6)
                Label:
                    text: '主题'
                    font_name: app.font_name
                    font_size: sp(13)
                    color: app.theme.text_label
                    size_hint_x: 0.22
                    halign: 'left'
                    text_size: self.width, None
                Button:
                    id: theme_dark_btn
                    text: '深色'
                    font_name: app.font_name
                    font_size: sp(13)
                    background_normal: ''
                    background_color: app.theme.accent if app.theme.pref == 'dark' else app.theme.btn
                    on_release: app.set_theme('dark')
                Button:
                    id: theme_light_btn
                    text: '浅色'
                    font_name: app.font_name
                    font_size: sp(13)
                    background_normal: ''
                    background_color: app.theme.accent if app.theme.pref == 'light' else app.theme.btn
                    on_release: app.set_theme('light')
                Button:
                    id: theme_system_btn
                    text: '跟随系统'
                    font_name: app.font_name
                    font_size: sp(13)
                    background_normal: ''
                    background_color: app.theme.accent if app.theme.pref == 'system' else app.theme.btn
                    on_release: app.set_theme('system')

            Label:
                text: '输出目录'
                font_name: app.font_name
                font_size: sp(13)
                color: app.theme.text_label
                size_hint_y: None
                height: dp(22)
                halign: 'left'
                text_size: self.width, None
            TextInput:
                id: out_input
                font_name: app.font_name
                font_size: sp(13)
                multiline: False
                size_hint_y: None
                height: dp(44)
                background_color: app.theme.input_bg
                foreground_color: app.theme.input_fg

            BoxLayout:
                size_hint_y: None
                height: dp(44)
                spacing: dp(8)
                Label:
                    text: '最低播放量'
                    font_name: app.font_name
                    font_size: sp(12)
                    color: app.theme.text_label
                    size_hint_x: 0.42
                    halign: 'left'
                    text_size: self.width, None
                TextInput:
                    id: play_input
                    font_name: app.font_name
                    font_size: sp(13)
                    multiline: False
                    input_filter: 'int'
                    background_color: app.theme.input_bg
                    foreground_color: app.theme.input_fg

            BoxLayout:
                size_hint_y: None
                height: dp(44)
                spacing: dp(8)
                Label:
                    text: '时长(秒)'
                    font_name: app.font_name
                    font_size: sp(12)
                    color: app.theme.text_label
                    size_hint_x: 0.30
                    halign: 'left'
                    text_size: self.width, None
                TextInput:
                    id: min_dur_input
                    font_name: app.font_name
                    font_size: sp(13)
                    multiline: False
                    input_filter: 'int'
                    background_color: app.theme.input_bg
                    foreground_color: app.theme.input_fg
                Label:
                    text: '~'
                    font_name: app.font_name
                    font_size: sp(13)
                    color: app.theme.text_label
                    size_hint_x: None
                    width: dp(16)
                TextInput:
                    id: max_dur_input
                    font_name: app.font_name
                    font_size: sp(13)
                    multiline: False
                    input_filter: 'int'
                    background_color: app.theme.input_bg
                    foreground_color: app.theme.input_fg

            Label:
                text: '时长范围：最短 / 最长（0 = 不限，默认 50 / 720 秒）'
                font_name: app.font_name
                font_size: sp(10)
                color: app.theme.text_hint
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                text_size: self.width, None

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(8)
                Label:
                    text: '曲库作者优先（同名歌优先原唱）'
                    font_name: app.font_name
                    font_size: sp(12)
                    color: app.theme.text_label
                    halign: 'left'
                    text_size: self.width, None
                CheckBox:
                    id: bili_music_check
                    size_hint_x: None
                    width: dp(44)

            BoxLayout:
                size_hint_y: None
                height: dp(42)
                spacing: dp(6)
                Label:
                    text: '格式'
                    font_name: app.font_name
                    font_size: sp(12)
                    color: app.theme.text_label
                    size_hint_x: None
                    width: dp(46)
                    halign: 'left'
                    text_size: self.width, None
                Button:
                    id: fmt_m4a
                    text: 'm4a'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    on_release: root.set_fmt('m4a')
                Button:
                    id: fmt_mp3
                    text: 'mp3'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    on_release: root.set_fmt('mp3')
                Button:
                    id: fmt_mp4
                    text: 'mp4'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    on_release: root.set_fmt('mp4')

            Label:
                text: 'mp4 仅在输入 BV 号 / 视频链接时生效，歌名搜索会按音频下载'
                font_name: app.font_name
                font_size: sp(11)
                color: app.theme.text_dim
                size_hint_y: None
                height: dp(20)
                halign: 'left'
                text_size: self.width, None

            Label:
                text: '优先级词条（越靠上越优先，支持正则）'
                font_name: app.font_name
                font_size: sp(13)
                color: app.theme.text_label
                size_hint_y: None
                height: dp(22)
                halign: 'left'
                text_size: self.width, None

            Label:
                text: '可写正则，例：(Hi-?res|无损)  4K|官方  完整版'
                font_name: app.font_name
                font_size: sp(10)
                color: app.theme.text_hint
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                text_size: self.width, None
                shorten: True

            BoxLayout:
                id: prio_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)

            BoxLayout:
                size_hint_y: None
                height: dp(42)
                spacing: dp(6)
                Button:
                    text: '添加'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    background_color: app.theme.btn
                    on_release: app.ask_add_prio()
                Button:
                    text: '全部清空'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    background_color: app.theme.btn
                    on_release: root.reset_words()

            Label:
                text: app.cookie_hint
                font_name: app.font_name
                font_size: sp(11)
                color: app.theme.ok_text if '已导入' in app.cookie_hint else app.theme.warn_text
                size_hint_y: None
                height: dp(20)
                halign: 'left'
                text_size: self.width, None

            Label:
                text: app.ffmpeg_hint
                font_name: app.font_name
                font_size: sp(11)
                color: app.theme.text_sub
                size_hint_y: None
                height: dp(20)
                halign: 'left'
                text_size: self.width, None

            Button:
                text: '使用说明（第一次用请看这个）'
                font_name: app.font_name
                font_size: sp(12)
                size_hint_y: None
                height: dp(44)
                background_normal: ''
                background_color: app.theme.ok_soft
                on_release: app.show_help()

            Button:
                text: '网络诊断（出问题点这个）'
                font_name: app.font_name
                font_size: sp(12)
                size_hint_y: None
                height: dp(40)
                background_normal: ''
                background_color: app.theme.neutral
                on_release: app.run_diag()

            Button:
                text: '扫码登录 B 站（提升音质 / 防限流）'
                font_name: app.font_name
                font_size: sp(12)
                size_hint_y: None
                height: dp(44)
                background_normal: ''
                background_color: app.theme.info
                on_release: app.open_qr_login()

            Button:
                text: '授予文件访问权限（写 /sdcard 必需）'
                font_name: app.font_name
                font_size: sp(12)
                size_hint_y: None
                height: dp(44)
                background_normal: ''
                background_color: app.theme.warn
                on_release: app.ask_storage_permission()

            Label:
                text: '自定义更新源（version.json 的 URL，留空 = 官方源）'
                font_name: app.font_name
                font_size: sp(10)
                color: app.theme.text_hint
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                text_size: self.width, None
            TextInput:
                id: update_url_input
                font_name: app.font_name
                font_size: sp(11)
                multiline: False
                size_hint_y: None
                height: dp(40)
                background_color: app.theme.input_bg
                foreground_color: app.theme.input_fg

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(6)
                Button:
                    text: '检查更新'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    background_color: app.theme.info_soft
                    on_release: app.check_update_now()
                Button:
                    text: '忘掉已确认的音源'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    background_color: app.theme.danger_soft
                    on_release: app.forget_confirm()

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(6)
                Button:
                    text: '导出故障统计'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    background_color: app.theme.neutral
                    on_release: app.export_metrics()
                Button:
                    text: '导出待补清单'
                    font_name: app.font_name
                    font_size: sp(12)
                    background_normal: ''
                    background_color: app.theme.neutral
                    on_release: app.export_need_list()

            Label:
                text: app.update_hint
                font_name: app.font_name
                font_size: sp(11)
                color: app.theme.ok_text if '最新' in app.update_hint else app.theme.warn_text
                size_hint_y: None
                height: dp(18)
                halign: 'left'
                text_size: self.width, None

            Button:
                text: '保存并返回'
                font_name: app.font_name
                font_size: sp(16)
                size_hint_y: None
                height: dp(50)
                background_normal: ''
                background_color: app.theme.ok
                on_release: root.save()
